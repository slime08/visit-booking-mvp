# Supabase PostgreSQL（直接接続）
# Supabaseダッシュボード > Project Settings > Database > Connection string > URI からコピー
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# JWT認証用シークレット（本番では必ず変更、32文字以上推奨）
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# アプリのベースURL（共有リンク生成用）
# Vercelデプロイ後は https://your-app.vercel.app に変更
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
